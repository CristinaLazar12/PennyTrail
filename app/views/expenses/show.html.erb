<h1><%= @expense.description %></h1>
<p><%= @expense.category %></p>
<p><%= @expense.spent_on %></p>
<p><%= number_to_currency(@expense.amount, unit: "RON ") %></p>
<%= link_to "Back to expenses", expenses_path %>
<%= link_to "Edit expense", edit_expense_path(@expense) %>

<%= button_to "Delete expense", expense_path(@expense),
        method: :delete,
        form: { data: { turbo_confirm: "Delete this expense?" } } %>
